// The headers' functions of internal linkage (`static ossl_inline`: every includer has its own, and
// none can be exported), declared again under their names, forwarding to them (1).
export namespace mcpplibs::mwrap::openssl {
mwrap_openssl_t<BIO_POLL_DESCRIPTOR> SSL_as_poll_descriptor(mwrap_openssl_t<SSL *> s) { return ::SSL_as_poll_descriptor(s); }
}  // namespace mcpplibs::mwrap::openssl
